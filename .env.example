# ---------------------------------------------------------------------------
# SUDAR JEWELS — example environment. Copy to .env and fill in real values.
# Never commit .env. Secrets live only here (or your host's secret manager).
# Business details (WhatsApp number, policies, commission rate, return window)
# are edited in Admin → Business settings, not here.
# ---------------------------------------------------------------------------
APP_NAME="SUDAR JEWELS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sudarjewels.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sudarjewels
DB_USERNAME=sudarjewels
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Workers: php artisan queue:work --queue=notifications,default,media
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email (affiliate notifications)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@sudarjewels.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin security --------------------------------------------------------
# Staff must enrol an authenticator app (TOTP) before using /admin.
ADMIN_REQUIRE_2FA=true

# --- SMS / OTP provider ----------------------------------------------------
# test  = local development only, sends nothing (refused when APP_ENV=production)
# msg91 = MSG91 Flow API (requires DLT-approved templates)
# twilio = Twilio Messaging
SMS_DRIVER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_TRANSACTIONAL_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Product media -----------------------------------------------------------
# "media" = storage/app/public/media (run php artisan storage:link).
# For a CDN, point MEDIA_DISK at an S3-compatible disk and set MEDIA_CDN_URL.
MEDIA_DISK=media
MEDIA_CDN_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Google Drive image import (optional) ----------------------------------
# Absolute path to a service-account JSON key stored OUTSIDE the web root.
# Share the Drive folder with the service account's email (read-only is enough).
GOOGLE_DRIVE_IMPORT_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# --- Analytics (optional) -----------------------------------------------------
# The measurement ID can also be set in Business settings.
GA4_MEASUREMENT_ID=
# Measurement Protocol API secret, used for server-side "purchase" events.
GA4_API_SECRET=

ORDER_NUMBER_PREFIX=SJ

VITE_APP_NAME="${APP_NAME}"
